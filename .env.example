# Copy to .env for local development. Never commit .env.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Comma-separated list; leave empty when the frontend is served by this app (same origin).
CORS_ORIGINS=
LOG_LEVEL=INFO
# Optional tuning (defaults shown in app/config.py)
# DATA_DIR=data
# FRONTEND_DIR=frontend
# CHUNK_SIZE_CHARS=900
# CHUNK_OVERLAP_CHARS=150
# MIN_DENSE_SCORE=0.30
# MIN_BM25_SCORE=3.0
# PRELOAD_EMBEDDING_MODEL=false
# FASTEMBED_CACHE_PATH=.fastembed_cache
